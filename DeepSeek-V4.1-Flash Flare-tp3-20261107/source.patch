+@pytest.mark.parametrize("fp8", [False, True])
+@pytest.mark.parametrize("world", [2, 3])
+def test_tp_vocabulary_sampling_native_replay(tmp_path, fp8, world):
+    if torch.cuda.device_count() < world:
+        pytest.skip("requires two explicitly assigned CUDA devices")
+    mp.spawn(_rank, args=((tmp_path / "rendezvous").as_uri(), fp8, world), nprocs=world, join=True)
