+    case 1: mma_mx<1, 0, 1>(d, v.x, v.z, v.y, v.w, b.x, b.y, sa, sb); break;
+    case 2: mma_mx<2, 0, 2>(d, v.x, v.z, v.y, v.w, b.x, b.y, sa, sb); break;
+    default: mma_mx<3, 0, 3>(d, v.x, v.z, v.y, v.w, b.x, b.y, sa, sb); break;
+  }
+}
