+def merged_bank() -> bool:
+    """FLARE_DS41_MERGED_BANK=1: parked layers use one mixed VRAM/host bank instead of hot + cold banks."""
+    return os.environ.get("FLARE_DS41_MERGED_BANK", "0") == "1"
