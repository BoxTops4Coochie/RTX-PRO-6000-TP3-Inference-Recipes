+int64_t flag_bytes() { return FLAG_BYTES; }
+
+int64_t inbox_bytes() { return 2L * 2 * 2 * PUB_SLOT * sizeof(__nv_bfloat16); }
+
+int64_t act_scale_bytes(int64_t m) { return QR / 128 * act_stride(int(m)); }
