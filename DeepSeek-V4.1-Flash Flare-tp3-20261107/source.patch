+        e.keep.append((self.wqa_s, self.wqb_s, self.fn, self.mix))
+        if os.environ.get("FLARE_DS41_BRRR_LOG") == "1":
+            print(f"[brrr] rank {r} layer {index} prologue: wqa {tuple(self.wqa.shape)} wqb {tuple(self.wqb.shape)} rows {m}", flush=True)
