# Copy to .env next to compose.yaml; docker compose reads it automatically.
HF_CACHE_DIR=/path/to/huggingface-cache

# Image: 20261019.4 = 20261019.3 + 4-bit Engram tables / NVFP4 expert support baked in (README-engram-nvfp4.md)
#DS41_IMAGE=azallaza/ds41-kraken-tp3:20261019.4

# Weights (any checkpoint in the original FP8 layout; see README "Alternative weights")
#MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# 4-bit Engram variants (need the 20261019.4 image or compose.nvfp4.yaml; see README-engram-nvfp4.md):
#MODEL=local/DeepSeek-V4.1-Flash-1017-engram-nvidia  # RECOMMENDED: stock experts + NVIDIA's Engram shards (patch-nvfp4/make_engram_nvidia_variant.py), 84.5 steps/s
#MODEL=local/DeepSeek-V4.1-Flash-1017-engram-mxfp4   # alternative: our converter (patch-nvfp4/make_engram_mxfp4.py), 84.4 steps/s
#MODEL=nvidia/DeepSeek-V4.1-Flash-1017-NVFP4          # NVIDIA NVFP4 experts + their Engram, 73.8 steps/s
# Both 4-bit Engram tables in host RAM (2 x 16.2 GiB/rank; needs ~150 GB host): +5% decode vs layer 14 on disk
#ENGRAM_RAM_LAYERS=1,14

# Expert promotion order (default = expert-order-blend, built from real traffic; see README)
#B12X_EXPERT_ORDER_DIR=/opt/ds41/expert-order   # the image's baked order (~-10% decode)

# ── KV cache preset (pick ONE; `./kv.sh 2x|4x|6x|8x` switches + restarts) ──
# Measured 2026-11-01 on image .7 (llm-inference-bench 32k, 350 W, two runs each; --concurrency 1,8 --coding-peak):
#            KV      capacity  1M slots  promotion (w13/w2)  c1 steps    c1 tok/s  c8 agg tok/s  coding mean/max
#   2x       2.25 GiB  2.18M    2.1      19/24 + 19/24       87.4-87.9   238-261   771-782       381-388 / 409-416   <- default
#   4x       4.75 GiB  4.61M    4.4      17/24 + 17/24       84.4-85.8   228-242   713-742       339-342 / 359-371
#   6x       6.5  GiB  6.31M    6.0      16/24 + 15/24       80.4-81.2   207-211   693-704       316-328 / 330-339
#   8x       8.75 GiB  8.50M    8.1      14/24 + 13/24       74.8-75.0   198-207   595-598       280 / 292-313
# More KV = fewer promoted experts (the VRAM comes out of promotion).
KV_CACHE_MEMORY_BYTES=2415919104   # 2x
#KV_CACHE_MEMORY_BYTES=5100273664   # 4x
#KV_CACHE_MEMORY_BYTES=6979321856   # 6x
#KV_CACHE_MEMORY_BYTES=9395240960   # 8x

# Concurrency: ds41-launch.yaml (mounted by compose.yaml) sets max-num-seqs 8 (graphs 48). 32k: c1 84 steps/s,
# c4 460 tok/s aggregate, c8 611 aggregate; stress-tested at 8 x 530K prompts. To go back to 4, edit that file
# (max-num-seqs: 4, max-cudagraph-capture-size: 24) or point DS41_LAUNCH_SETTINGS at your own copy.

# Cap-only adaptive verification (image .5). Every DSpark draft is verified while the decoding requests' total
# target rows (1 + 5 drafts each) fit under this cap; above it drafts are trimmed, best-confidence first across
# requests. 24 = up to 4 requests untouched. 32k, 2026-10-31: c1/c4 unchanged, c6 512 -> 635, c8 611 -> 752 tok/s
# aggregate; c8 KV stress PASS. 0 = upstream's cost-model adaptive (c1 -11%). To verify every draft at any
# concurrency set adaptive-verification: false in ds41-launch.yaml instead.
#DS41_VERIFY_ROW_CAP=24
